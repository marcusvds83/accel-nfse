# === Servidor ===
PORT=3000
API_KEY=sua-api-key-aqui

# === Firebase (cofre do certificado A1) ===
# Crie um projeto no Firebase Console > Project Settings > Service Accounts
# Baixe a chave JSON e copie os campos abaixo
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=seu-sa@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----"
FIREBASE_CERT_COLLECTION=certificados
FIREBASE_CERT_DOC_ID=nytro-a1

# === NFS-e ===
NFSE_UF=PR
NFSE_CIDADE=Curitiba
NFSE_CODIGO_IBGE=4106902
NFSE_TP_AMB=2                # 1=producao, 2=homologacao
NFSE_EMISSAO_MODO=proprio     # proprio | sieg
NFSE_SERIE=1
NFSE_STATUS_ON_ERROR=erro    # erro | pendente

# === Odoo ===
ODOO_ENABLED=1
ODOO_URL=https://nytro.odoo.com
ODOO_DB=nytro
ODOO_LOGIN=seu-usuario
ODOO_PASSWORD=sua-senha
ODOO_POLLING_MS=15000

# === Webservice Prefeitura Curitiba (ABRASF v2) ===
# Preencher quando confirmarmos as URLs corretas
PREF_HOM_RECEBER_LOTE=
PREF_HOM_CONSULTAR_LOTE=
PREF_HOM_CONSULTAR_NFSE=
PREF_HOM_CANCELAR_NFSE=
PREF_PROD_RECEBER_LOTE=
PREF_PROD_CONSULTAR_LOTE=
PREF_PROD_CONSULTAR_NFSE=
PREF_PROD_CANCELAR_NFSE=

# === Seguranca ===
# NFSE_TLS_INSECURE=1    # Desativa validacao TLS (debug)
# NFSE_CERT_KEK=sua-chave-mestra-para-cifrar-senha
