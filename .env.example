FIREBASE_PRIVATE_KEY="[REDACTED:ssh_private_key]\nMIIEv...\n-----END PRIVATE KEY-----"
FIREBASE_CERT_COLLECTION=certificados
FIREBASE_CERT_DOC_ID=accel-a1

